# ============================================================
#  PREDICTION MARKET BOT — CONFIGURATION
#  Copy this file to .env and fill in your credentials.
#  NEVER commit .env to git — it contains private keys.
# ============================================================


# ── Bot behavior ─────────────────────────────────────────────
# Which platforms to use: kalshi (default), polymarket, or kalshi,polymarket
PLATFORMS=kalshi

# Strategy: favorite (default, evidence-based) | arb | edge | maker | all
BOT_MODE=favorite

# Favorite strategy: buy contracts priced 60-95c with resting orders, hold to settlement
FAV_MIN_PRICE=0.60
FAV_MAX_PRICE=0.95
FAV_MIN_MINUTES_TO_CLOSE=15
FAV_MAX_DAYS_TO_CLOSE=14

# Max $ per single trade leg (small on purpose: this is a learning system)
MAX_POSITION_USD=1

# Trade size grows with your account: 20% of account value, at least $1,
# never more than MAX_POSITION_USD, and never more cash than you actually have.
RAMP_FRACTION=0.2
RAMP_FLOOR_USD=1

# Daily loss limit — bot pauses if this is hit
DAILY_LOSS_LIMIT_USD=5

# Min arbitrage gap % to fire (after fees)
ARB_MIN_EDGE_PCT=2.0

# Min model vs market deviation % for edge hunting
EDGE_MIN_DEVIATION_PCT=5.0

# Fractional Kelly sizing (0.25 = quarter Kelly — recommended)
KELLY_FRACTION=0.25

# Caps on everything at once (the bot reads real numbers from Kalshi to enforce these)
MAX_OPEN_POSITIONS=10
MAX_TOTAL_EXPOSURE_USD=10
MAX_RESTING_ORDERS=20

# Market making: $ per side, and how often stale quotes are cancelled and re-posted
MAKER_SIZE_USD=1
MAKER_REFRESH_SEC=120

# How often to scan (seconds), and how long without a good scan before the watchdog restarts the bot
SCAN_INTERVAL_SEC=5
STALL_AFTER_SEC=600

LOG_LEVEL=INFO

# /health shows only healthy + seconds since last scan unless this token is sent
# as ?token=... or Authorization: Bearer ... Use a long random string.
HEALTH_TOKEN=


# ── Kalshi credentials ────────────────────────────────────────
# 1. Go to https://kalshi.com/account/profile
# 2. Scroll to "API Keys" section
# 3. Click "Create New API Key"
# 4. Copy the Key ID here and save the .pem file to keys/kalshi_private.pem

KALSHI_API_KEY_ID=your_key_id_here
KALSHI_PRIVATE_KEY_PATH=keys/kalshi_private.pem

# IMPORTANT: Start with demo=true to test without real money!
# Demo URL: demo-api.kalshi.co (separate account at demo.kalshi.co)
KALSHI_DEMO_MODE=true


# ── Polymarket credentials (optional, only for PLATFORMS=polymarket) ──
# A wallet private key controls real funds. Use a dedicated wallet with a small balance,
# keep it only in .env or your host's secret store, and never paste it anywhere else.
# HOW TO GET YOUR PRIVATE KEY:
#   Option A (email/Google account):
#     1. Log in to polymarket.com
#     2. Click "Cash" (bottom of screen)
#     3. Click the three-dot menu (...)
#     4. Click "Export Private Key"
#     5. Paste it below (starts with 0x)
#
#   Option B (MetaMask):
#     1. Open MetaMask
#     2. Account Details > Export Private Key
#
# HOW TO GET YOUR FUNDER ADDRESS:
#     1. Go to https://polymarket.com/settings
#     2. Copy the wallet address shown there
#     NOTE: This is NOT always your MetaMask address!

POLYMARKET_PRIVATE_KEY=0xyour_private_key_here
POLYMARKET_FUNDER_ADDRESS=0xyour_funder_address_here
